{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/run-vite.mjs",
    "build": "vue-tsc --noEmit && node ./scripts/run-vite.mjs build",
    "preview": "node ./scripts/run-vite.mjs preview",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual-baseline.spec.ts",
    "test:visual:update": "playwright test e2e/visual-baseline.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.6.8",
    "echarts": "^5.4.3",
    "element-plus": "^2.4.4",
    "pinia": "^2.1.7",
    "sass": "^1.69.7",
    "vue": "^3.4.38",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  }
}
